{
  "name": "your-dialogue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A visual novel desktop client for everyday AI conversations",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "package": "npm run build && electron-builder --dir",
    "lint": "eslint src tests vite.config.ts",
    "format": "prettier --write src tests scripts *.json *.ts *.html README.md",
    "format:check": "prettier --check src tests scripts *.json *.ts *.html README.md"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "prettier": "^3.6.2"
  },
  "build": {
    "appId": "com.yourdialogue.desktop",
    "productName": "YourDialogue",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!dist/licenses/**"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity"
    },
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "dist/licenses",
        "to": "licenses"
      }
    ]
  },
  "license": "MIT"
}
